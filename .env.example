# Database
# Pooled connection (app runtime) - PgBouncer/Supabase pooler port 6543
DATABASE_URL="postgresql://postgres:password@localhost:5432/myapp"
# Direct connection (prisma migrate deploy) - port 5432
DIRECT_URL="postgresql://postgres:password@localhost:5432/myapp&connect_timeout=30"

# Public API URL (frontend → backend)
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Auth (Better Auth / your auth system)
BETTER_AUTH_URL="http://localhost:3000"
AUTH_SECRET="super-secret-auth-key-change-this"
BETTER_AUTH_SECRET="another-super-secret-key-change-this"

# OAuth Providers
GITHUB_CLIENT_ID="Iv1.1234567890abcdef"
GITHUB_CLIENT_SECRET="ghp_abcdefghijklmnopqrstuvwxyz123456"

GOOGLE_CLIENT_ID="1234567890-abcdefghijklmnop.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-abcdefghijklmnopqrstuvwxyz"

# SMTP (Email service)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-email-app-password"
SMTP_FROM_NAME="My App"
SMTP_FROM_EMAIL="noreply@myapp.com"

# Admins (comma-separated)
ADMIN_EMAILS="admin1@example.com,admin2@example.com"